{
  "name": "prestamo-de-un-libro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reglas del préstamo, API y pruebas de la cátedra de Programación Extrema.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests e2e playwright.config.ts vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"docs/**/*.md\" \"playwright.config.ts\" \"vitest.config.ts\"",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:browser": "playwright test",
    "test": "vitest run && npm run test:e2e",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.4",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  }
}
