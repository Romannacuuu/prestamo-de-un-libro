{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "prestamo-de-un-libro",
      "public": "frontend/dist/frontend/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "site": "prestamo-principito-rom",
      "public": "frontend/dist/frontend/browser",
      "redirects": [
        {
          "source": "**",
          "destination": "https://prestamo-de-un-libro.web.app",
          "type": 301
        }
      ]
    }
  ]
}
